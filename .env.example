# =============================================================================
# BUGS Auto Quality Cars - environment variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase - safe to expose to the browser
# -----------------------------------------------------------------------------
# Hosted project : https://<project-ref>.supabase.co
# Local dev      : http://127.0.0.1:54321  (printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. Row Level Security is what protects your data,
# so this key is safe in client bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase - SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# Bypasses Row Level Security. Used only in server-side code for:
#   * writing validated customer submissions (inquiries, test drives)
#   * uploading vehicle media on behalf of an authenticated admin
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute base URL, used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: used by `npm run create-admin` to provision the first admin account.
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
